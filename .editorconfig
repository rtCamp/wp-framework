# https://editorconfig.org
# WordPress Core convention: tabs for indentation, Unix line endings, UTF-8.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = tab
insert_final_newline = true
trim_trailing_whitespace = true

# Two-space indent for config and data files.
[*.{yml,yaml,json,md}]
indent_size = 2
indent_style = space

# Makefiles use real tabs — not configurable.
[Makefile]
indent_style = tab
