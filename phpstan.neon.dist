# PHPStan configuration — wp-php-toolkit
# Docs: https://phpstan.org/config-reference

includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 5
    phpVersion: 80300

    paths:
        - src

    excludePaths:
        - vendor
        - tests

    # Treat unmatched ignore patterns as errors so stale suppressions get flagged.
    reportUnmatchedIgnoredErrors: true
